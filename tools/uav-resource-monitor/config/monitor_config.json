{
  "sample_interval": 1.0,
  "data_directory": "../data",
  "log_directory": "../logs", 
  "output_format": "both",
  "temperature_sensors": {
    "cpu": "/sys/class/thermal/thermal_zone0/temp",
    "gpu": "/sys/class/thermal/thermal_zone1/temp"
  },
  "voltage_path": "/sys/firmware/devicetree/base/system/linux,revision",
  "network_interface": null,
  "disk_path": "/",
  "enable_detailed_logging": true,
  "monitoring_presets": {
    "high_frequency": {
      "sample_interval": 0.5,
      "description": "High frequency monitoring for intensive workloads"
    },
    "standard": {
      "sample_interval": 1.0,
      "description": "Standard monitoring for general use"
    },
    "low_frequency": {
      "sample_interval": 5.0,
      "description": "Low frequency monitoring for long-term analysis"
    },
    "battery_saver": {
      "sample_interval": 10.0,
      "description": "Battery saving mode for extended monitoring"
    }
  },
  "alert_thresholds": {
    "cpu_percent": 90,
    "memory_percent": 95,
    "cpu_temp": 75,
    "disk_percent": 90
  },
  "auto_cleanup": {
    "enabled": true,
    "max_files": 50,
    "max_age_days": 30
  }
}
